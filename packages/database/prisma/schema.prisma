generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id
  name                  String
  email                 String
  emailVerified         Boolean
  image                 String?
  createdAt             DateTime
  updatedAt             DateTime
  sessions              Session[]
  accounts              Account[]
  phoneNumber           String?
  phoneNumberVerified   Boolean?

  stocks                Stock[]
  transactions          Transaction[]
  balance               Balance?
  @@unique([email])
  @@map("user")
}

model Balance {
    id            String   @id @default(uuid())
    available     Int      @default(0)
    locked        Int      @default(0) 
    userId        String   @unique
    user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  }

model Transaction {
    id          String    @id @default(uuid())
    event       String 
    type        YesNo
    noOfTokens  Int 
    price       String 
    filled      Boolean
    mode        Mode 
    userId      String
    user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  }

enum Mode {
  BUY 
  SELL 
}

enum YesNo {
  YES
  NO 
}

model Stock {
  id              String @id @default(uuid())
  event           String @unique
  Available       Int 
  locked          Int
  userId          String
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  }

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

